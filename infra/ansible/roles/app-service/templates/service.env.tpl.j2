{{ ansible_managed | comment }}
# {{ item.name }} environment.
#
# THIS IS A TEMPLATE, TWICE OVER, and the two layers do different jobs:
#
#   Jinja (here, at deploy time)      non-secret values from the inventory
#   dollar-brace (on the box, start)  secrets, substituted by
#                                     fetch-and-render-secrets.sh from
#                                     Secrets Manager
#
# The split is what keeps resolved secrets out of this repository, out of
# Ansible's S3 transport bucket, and out of any play's diff. Anything secret
# belongs in the dollar-brace layer — put it in the Secrets Manager container,
# not here. Prose in this file deliberately never spells a placeholder in its
# literal form: substitution is a blind pass over the whole file, so one in a
# comment is replaced there too, and it is indistinguishable from a genuinely
# unsubstituted value to any check that counts leftovers.
#
# The rendered sibling ({{ item.name }}.env) is what the container reads and is
# never written by Ansible.

# ---- Environment ----------------------------------------------------------
APP_ENV={{ env_name }}
AWS_REGION={{ aws_region }}
NODE_ID={{ app_node_id }}

# ---- Listeners ------------------------------------------------------------
{% if item.name == 'esl-controller' %}
# Where FreeSWITCH's per-call &socket() lands. Must match esl_listener_port in
# the Terraform control-plane stack — the NLB listener and target group are
# both built from it.
ESL_LISTEN_ADDR=0.0.0.0:{{ esl_listener_port }}

# TCP keepalive on ACCEPTED sockets. THE PRIMARY DEFENCE against an idle
# middlebox reaping a quiet ESL connection — an `async full` socket goes silent
# during hold with music, and the NLB's idle timeout would otherwise kill it
# with no FIN, dropping the call. Terraform also raises the NLB timeout to
# 1200s, but that only covers that one hop.
ESL_TCP_KEEPALIVE_SECONDS={{ esl_tcp_keepalive_seconds }}

# Inbound ESL, the other direction: the controller connects OUT to each
# FreeSWITCH node to originate and to subscribe to events.
FREESWITCH_NODES={{ freeswitch_private_ips | join(',') }}
FREESWITCH_ESL_PORT={{ freeswitch_esl_inbound_port }}
FREESWITCH_ESL_PASSWORD=${FREESWITCH_ESL_PASSWORD}

# THE CONTROLLER TALKS TO POSTGRES DIRECTLY. It used to reach the control
# plane over HTTP for admission and for every call-state write; both now go
# straight to the database (docs/API.md, Contracts 1 and 2).
#
# CONTROL_PLANE_API_URL and CONTROL_PLANE_API_TOKEN are deliberately absent —
# there is no HTTP dependency left in the call path, which is the point: the
# control plane restarts on every deploy, and a per-call question asked of it
# made each of those a window where calls failed.
DATABASE_URL=${DATABASE_URL}
DATABASE_MAX_CONNS={{ esl_controller_db_max_conns }}

# Where FreeSWITCH opens its per-call socket for an OUTBOUND call, once the far
# end answers. The same DNS name the inbound dialplan uses, and for the same
# reason: it resolves straight to the app instance, so the controller can be
# moved by repointing a record rather than touching a FreeSWITCH node.
#
# The controller cannot derive it — the listener binds 0.0.0.0 and sits behind
# that record. Unset disables the originate WORKER and says so in the log;
# inbound calls are unaffected, which is why this is not fatal.
ESL_CALLBACK_TARGET={{ freeswitch_esl_outbound_target }}

# Kamailio's PRIVATE address, as sip_route_uri on an outbound originate.
#
# THE CONTROLLER DOES NOT TALK TO KAMAILIO. This value is handed to FreeSWITCH,
# which is what sends the packet; the controller only needs to know what to put
# in the dial string.
#
# WHY IT IS NOT COVERED BY THE DIALPLAN, which exports sip_route_uri onto every
# other egress leg: an originate has no inbound A-leg, so no dialplan runs. The
# note in dialplan-public.xml.j2 says the same thing from the other side.
#
# PRIVATE, NOT THE ELASTIC IP. FreeSWITCH is in the sip subnet and the edge
# security group admits the farm by security-group reference, which only ever
# matches a private source. The public address renders fine, is accepted by
# FreeSWITCH, and is dropped at the boundary.
#
# Unset disables outbound originate and says so at startup. Before this
# existed, originates were accepted, marked `placed`, and never reached the
# edge at all - nothing failed anywhere that anyone was looking.
EDGE_SIP_ROUTE=sip:{{ edge_private_ips[0] }}:{{ sip_port }}

# LiveKit. Empty until the LiveKit location is confirmed — see the note in
# group_vars/all.yml. With these unset the AI leg does not connect, which is
# the intended failure.
LIVEKIT_URL=${LIVEKIT_URL}
LIVEKIT_API_KEY=${LIVEKIT_API_KEY}
LIVEKIT_API_SECRET=${LIVEKIT_API_SECRET}
{% endif %}
{% if item.name == 'control-plane' %}
API_LISTEN_ADDR=0.0.0.0:{{ api_listener_port }}

DATABASE_URL=${DATABASE_URL}
DATABASE_MAX_CONNS={{ control_plane_db_max_conns }}
CONTROL_PLANE_API_TOKEN=${CONTROL_PLANE_API_TOKEN}

# Where a carrier must send inbound calls: the edge's Elastic IP.
#
# NOT stored per trunk, and not a secret — it is infra state, and the inventory
# already holds it. A copy in the database would be one address in two places
# with nothing keeping them in step.
#
# Taken from edge_public_ips, NOT kamailio_public_ip: that one is a host_var on
# the EDGE, so it is undefined here. edge_public_ips extracts it across hosts,
# the same way edge_private_ips does.
#
# Read only by trunk drift detection, which compares it against the Origination
# URI configured in Twilio's console. That check is the most valuable of the
# four: point origination anywhere else and NO INBOUND CALL EVER ARRIVES, with
# nothing to see on our side, because the packet never reaches the edge.
#
# Harmless while the Twilio credentials below are absent — drift is disabled
# and the endpoint answers 501.
EDGE_SIP_URI=sip:{{ edge_public_ips[0] }}:{{ sip_port }}

# JWT_SIGNING_KEY AND THE TWILIO CREDENTIALS ARE DELIBERATELY ABSENT.
#
# JWT_SIGNING_KEY stays absent for good: nothing signs a token. The API
# authenticates with bearer keys from the api_keys table — hashed at rest,
# scoped, revocable — and there is no identity provider or admin UI to issue a
# JWT against. The service does NOT require the key, so this omission is not a
# startup failure; that is asserted by a test.
#
# The Twilio credentials are absent until someone wants drift detection. They
# are added back with the feature that needs them, and with the keys put in the
# Secrets Manager container in the SAME change.
#
# WHY NOT JUST LEAVE THE LINES HERE. Substitution builds its allowlist from
# the keys PRESENT IN THE SECRET, so a line whose key is absent is not
# substituted — it is left literal. The container would start holding
#
#   JWT_SIGNING_KEY=<dollar-brace>JWT_SIGNING_KEY<close>
#
# which is harmless only until something reads it. os.Getenv then returns a
# non-empty 20-character string, so an `if key == ""` guard PASSES and tokens
# get signed with a placeholder instead of the service refusing to start. The
# same shape cost us an afternoon on Kamailio's secrets.cfg.
#
# When they come back, prefer a TWILIO API KEY over the account auth token:
#
#   TWILIO_ACCOUNT_SID     AC...  identifies the account
#   TWILIO_API_KEY_SID     SK...  revocable on its own
#   TWILIO_API_KEY_SECRET
#
# The account auth token authenticates every API call AND is the thing you
# rotate if it leaks — rotating it breaks every integration at once, and it
# can change account-level settings. An API key is scoped, individually
# revocable, and the Twilio SDKs accept it in place of the auth token.
#
# THE SERVICE ALREADY PREFERS THE KEY. It authenticates as the API key SID when
# one is set and falls back to the account auth token otherwise; the account
# SID is still needed either way, because it identifies WHICH account in the
# URL path. So this becomes four lines when the time comes, not a code change.

# NO KAMAILIO_NODES / KAMAILIO_XHTTP_PORT. The control plane does not drive
# Kamailio at all — originate is controller -> FreeSWITCH over ESL, and the
# xhttp control listener it addressed no longer exists (Contract 3).
{% endif %}

# ---- Health ---------------------------------------------------------------
# PER SERVICE, NOT ONE SHARED PORT. Both containers run with --network host on
# a single instance, so they share one port namespace: rendering the same port
# into both means the second to start cannot bind, and it fails while the first
# stays healthy and everything looks fine from outside.
#
# MAKE THE ENDPOINT ASSERT DEPENDENCIES, not just liveness — a check that only
# proves the process is running keeps a wedged node in rotation, and every call
# routed to it is dropped.
HEALTH_LISTEN_ADDR=0.0.0.0:{{ item.health_port }}
HEALTH_PATH={{ health_check_path }}
