#!/usr/bin/env bash
#
# seed-runtime-secrets — fill the runtime Secrets Manager containers for an
# environment, then merge in the database DSN.
#
# Usage:
#   seed-runtime-secrets <env>
#
# Run after `make apply STACK=secrets-manager` and `STACK=database`, before the
# first playbook. Containers it fills:
#
#   intron-sip/<env>/freeswitch       FREESWITCH_ESL_PASSWORD, FREESWITCH_XMLRPC_USER,
#                                     FREESWITCH_XMLRPC_PASSWORD
#   intron-sip/<env>/livekit          LIVEKIT_API_KEY, LIVEKIT_API_SECRET
#   intron-sip/<env>/esl-controller   FREESWITCH_ESL_PASSWORD, LIVEKIT_API_KEY,
#                                     LIVEKIT_API_SECRET, LIVEKIT_URL
#   intron-sip/<env>/control-plane    CONTROL_PLANE_API_TOKEN
#
# and finally runs bin/db-dsn-to-sm, which adds DATABASE_URL to the last two.
#
# FILLS GAPS, NEVER ROTATES. A key already present is kept; only missing keys
# are generated. So re-running is safe — on a populated environment it writes
# nothing — and a half-finished run is completed by running it again.
#
# Nothing is asked for: every value is generated. There are no carrier
# credentials, because the control plane calls no carrier's API.
#
# Rotation is deliberately not a flag. Rotating the ESL password or the LiveKit
# pair breaks every running service that holds the old value until it is
# replayed, and the LiveKit pair also lives in the agent's .env on another
# machine. To rotate: delete the key from EVERY container that holds it (see
# the note in bin/env-file-to-sm), re-run this, replay the affected playbooks,
# and update the agent.
#
# SHARED VALUES STAY IN STEP. The ESL password lives in two containers and the
# LiveKit pair in two. If one copy exists it is reused for the other; if the two
# copies disagree the script stops rather than pick one, because either guess
# leaves a service failing auth with an error that names neither container.
#
# Values are hex — no `/`, `+` or `=` to break a KEY=value line or a config
# template — and are never printed. Writes go through bin/env-file-to-sm, so
# they merge and keep any key this script does not know about.

set -euo pipefail

ENV_NAME="${1:?usage: $0 <env>}"
here="$(cd "$(dirname "$0")" && pwd)"

for bin in aws jq openssl; do
  command -v "$bin" >/dev/null || {
    echo "seed-runtime-secrets: '$bin' not found in PATH" >&2
    exit 127
  }
done

# Defaulted, not inherited, for the reason given in bin/env-file-to-sm: this
# writes credentials, and the wrong account is the bad outcome.
export AWS_PROFILE="${AWS_PROFILE:-intron_aws}"
export AWS_REGION="${AWS_REGION:-eu-west-1}"

die() { echo "seed-runtime-secrets: $*" >&2; exit 1; }

# The container's JSON object, or {} if it has no value yet. Any other read
# failure stops the script: treating it as empty would generate a fresh value
# next to a live one.
read_secret() {
  local id="intron-sip/${ENV_NAME}/$1" out
  if ! out=$(aws secretsmanager get-secret-value --secret-id "$id" \
        --query SecretString --output text 2>&1); then
    if [[ "$out" == *ResourceNotFoundException* && "$out" == *AWSCURRENT* ]]; then
      echo '{}'
      return
    fi
    echo "seed-runtime-secrets: could not read $id" >&2
    echo "$out" >&2
    exit 1
  fi
  jq -e 'type == "object"' >/dev/null 2>&1 <<<"$out" \
    || die "$id holds something that is not a JSON object"
  printf '%s' "$out"
}

get() { jq -r --arg k "$2" '.[$k] // empty' <<<"$1"; }

# pick KEY JSON... — the value of KEY across the given containers. Empty if
# none has it; stops if two have different values.
pick() {
  local key="$1" found="" v j
  shift
  for j in "$@"; do
    v=$(get "$j" "$key")
    [[ -z "$v" ]] && continue
    [[ -n "$found" && "$v" != "$found" ]] \
      && die "$key differs between containers — reconcile by hand, refusing to guess"
    found="$v"
  done
  printf '%s' "$found"
}

note() { if [[ -n "$2" ]]; then echo "  kept       $1"; else echo "  generating $1"; fi; }

echo "== reading intron-sip/${ENV_NAME}/*"
fs=$(read_secret freeswitch)
lk=$(read_secret livekit)
ctl=$(read_secret esl-controller)
cp=$(read_secret control-plane)

ESL=$(pick FREESWITCH_ESL_PASSWORD "$fs" "$ctl");    note FREESWITCH_ESL_PASSWORD "$ESL"
XR_USER=$(pick FREESWITCH_XMLRPC_USER "$fs");        note FREESWITCH_XMLRPC_USER "$XR_USER"
XR_PASS=$(pick FREESWITCH_XMLRPC_PASSWORD "$fs");    note FREESWITCH_XMLRPC_PASSWORD "$XR_PASS"
LK_KEY=$(pick LIVEKIT_API_KEY "$lk" "$ctl");         note LIVEKIT_API_KEY "$LK_KEY"
LK_SECRET=$(pick LIVEKIT_API_SECRET "$lk" "$ctl");   note LIVEKIT_API_SECRET "$LK_SECRET"
LK_URL=$(pick LIVEKIT_URL "$ctl");                   note LIVEKIT_URL "$LK_URL"
CP_TOKEN=$(pick CONTROL_PLANE_API_TOKEN "$cp");      note CONTROL_PLANE_API_TOKEN "$CP_TOKEN"

# A key and a secret generated separately would not be a pair LiveKit
# accepts. Half a pair means someone edited a container by hand.
if [[ -n "$LK_KEY" && -z "$LK_SECRET" ]] || [[ -z "$LK_KEY" && -n "$LK_SECRET" ]]; then
  die "only half of the LiveKit key pair exists — reconcile by hand"
fi
lk_generated=false
[[ -z "$LK_KEY" ]] && lk_generated=true

: "${ESL:=$(openssl rand -hex 24)}"
: "${XR_USER:=intron}"
: "${XR_PASS:=$(openssl rand -hex 24)}"
: "${LK_KEY:=API$(openssl rand -hex 6)}"
: "${LK_SECRET:=$(openssl rand -hex 32)}"
: "${CP_TOKEN:=$(openssl rand -hex 32)}"

# The URL is not a secret but the controller reads it from here. Override with
# LIVEKIT_URL_DEFAULT if the hostname scheme ever changes; an existing value
# always wins.
: "${LK_URL:=${LIVEKIT_URL_DEFAULT:-wss://livekit-${ENV_NAME}.intron.quiverlearn.com}}"

# Scoped to this process: the caller's shell keeps its own umask.
umask 077
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

cat >"$tmp/freeswitch.env" <<EOF
FREESWITCH_ESL_PASSWORD=$ESL
FREESWITCH_XMLRPC_USER=$XR_USER
FREESWITCH_XMLRPC_PASSWORD=$XR_PASS
EOF

cat >"$tmp/livekit.env" <<EOF
LIVEKIT_API_KEY=$LK_KEY
LIVEKIT_API_SECRET=$LK_SECRET
EOF

cat >"$tmp/esl-controller.env" <<EOF
FREESWITCH_ESL_PASSWORD=$ESL
LIVEKIT_API_KEY=$LK_KEY
LIVEKIT_API_SECRET=$LK_SECRET
LIVEKIT_URL=$LK_URL
EOF

cat >"$tmp/control-plane.env" <<EOF
CONTROL_PLANE_API_TOKEN=$CP_TOKEN
EOF

unset ESL XR_PASS LK_SECRET CP_TOKEN

# Skip a container whose keys already hold exactly these values, so a re-run on
# a populated environment creates no new secret versions.
echo "== writing"
for component in freeswitch livekit esl-controller control-plane; do
  case "$component" in
    freeswitch)     current="$fs" ;;
    livekit)        current="$lk" ;;
    esl-controller) current="$ctl" ;;
    control-plane)  current="$cp" ;;
  esac
  wanted=$(jq -Rn '[inputs | capture("^(?<k>[^=]+)=(?<v>.*)$") | {(.k): .v}] | add' \
    <"$tmp/$component.env")
  if jq -e --argjson c "$current" --argjson w "$wanted" \
       '($c + $w) == $c' >/dev/null <<<'null'; then
    echo "  unchanged  intron-sip/${ENV_NAME}/${component}"
    continue
  fi
  "$here/env-file-to-sm" "intron-sip/${ENV_NAME}/${component}" "$tmp/$component.env"
done

echo "== database"
"$here/db-dsn-to-sm" "$ENV_NAME"

if [[ "$lk_generated" == true ]]; then
  cat <<EOF

A NEW LiveKit key pair was generated. The agent worker needs it in its .env
(LIVEKIT_API_KEY / LIVEKIT_API_SECRET). Read it from intron-sip/${ENV_NAME}/livekit
when configuring the agent — it is not printed here.
EOF
fi
