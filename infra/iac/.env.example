# Copy to iac/.env, fill in, then:
#   make populate-iac ENV=beta TOKEN=<6-digit>
#
# This file is gitignored. After populating, the values live in
# intron-sip/<env>/iac in Secrets Manager, and bin/aws-env-run loads them into
# Terraform's process at plan/apply time — so nothing ends up in a tfvars file
# on disk or in a commit.
#
# Values are TF_VAR_* so Terraform picks them up directly. List-typed variables
# must be valid JSON.

# ---------------------------------------------------------------------------
# Carrier signalling ranges allowed to reach the edge on 5060/5061.
#
# EMPTY MEANS NO CALLS ARRIVE — which is obvious within a minute of testing.
# The tempting alternative, 0.0.0.0/0, means calls arrive and so does everyone
# else: an open 5060 is found by scanners within hours, and the first thing
# they try is toll fraud.
#
# TAKE THE CURRENT VALUES FROM THE CARRIER, NOT FROM AN EXAMPLE:
#   - Twilio publishes its SIP trunking ranges per region, and changes them.
#     The region matters — a trunk homed in Dublin does not signal from the
#     same addresses as one homed in Ashburn.
#   - Add one entry per client BYOT SBC as clients are onboarded.
#
# SIGNALLING ONLY. Do not add media ranges — RTP arrives from addresses that
# cannot be enumerated, which is why that security group rule is separate and
# deliberately wide.
# ---------------------------------------------------------------------------
TF_VAR_carrier_sip_cidrs=[]

# ---------------------------------------------------------------------------
# Where livekit-sip reaches the edge from.
#
# THE PRIVATE ADDRESS OF OUR OWN LiveKit BOX, as a /32. This used to be the
# PUBLIC egress addresses of Intron's LiveKit in another AWS account, when the
# AI leg was an internet SIP trunk on 5061 with SRTP required.
#
# We run livekit-sip ourselves now (iac/stacks/livekit), so the leg is private
# and the transport dropped to plain UDP. That is the migration docs/LIVEKIT.md
# predicted — this variable and livekit_sip_host, nothing else — arrived at by
# moving livekit-sip rather than by peering the two accounts.
#
#   cd infra/iac
#   make output STACK=livekit ENV=beta EXTRA="livekit_private_ips"
#
#   TF_VAR_livekit_cidrs=["10.70.0.30/32"]
#
# WHAT THIS OPENS is the EDGE's side of the leg: RTP back from livekit-sip to
# RTPEngine, and SIP on 5060/udp. The LiveKit box's own side is opened in its
# stack, sourced from the edge SECURITY GROUP rather than a CIDR.
#
# Empty means the AI leg does not connect. That is still the correct failure.
# ---------------------------------------------------------------------------
TF_VAR_livekit_cidrs=[]
