# Local development only. Copy to .env, which is gitignored.
#
# On the app instance NONE of this file exists. Ansible's app-service role
# renders an env file from Secrets Manager at every service start and passes it
# with --env-file — so the keys here mirror
# infra/ansible/roles/app-service/templates/service.env.tpl.j2 and adding one
# to the application means adding it THERE first.

# ---- Shared -----------------------------------------------------------------
APP_ENV=local
AWS_REGION=eu-central-1
NODE_ID=laptop

HEALTH_LISTEN_ADDR=0.0.0.0:8088
HEALTH_PATH=/healthz

# ---- Database ---------------------------------------------------------------
# Both services connect directly. Cap the pools: db.t4g.micro is ~110
# connections in total, and two driver defaults can eat most of that.
DATABASE_URL=postgres://intron:intron@localhost:5432/control_plane?sslmode=disable
DATABASE_MAX_CONNS=10

# ---- control-plane ----------------------------------------------------------
API_LISTEN_ADDR=0.0.0.0:8080
CONTROL_PLANE_API_TOKEN=local-dev-token
JWT_SIGNING_KEY=local-dev-signing-key

# Optional. Trunk sync fails at the point of use when these are empty, rather
# than stopping the API from serving configuration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Where a carrier must send inbound calls: the edge's Elastic IP.
#
# NOT stored per trunk — it is infra state, and Ansible already holds it as
# kamailio_public_ip, rendered from the sip-core stack's edge_public_ips
# output. One address, one source.
#
# Used to CHECK what Twilio has configured. A wrong Origination URI means no
# inbound call ever arrives, with nothing visible on our side, because the
# packet never reaches the edge.
EDGE_SIP_URI=sip:63.182.163.164:5060

# esl-controller only. Kamailio PRIVATE address, used as sip_route_uri on an
# outbound originate. Unset disables outbound originate.
EDGE_SIP_ROUTE=sip:10.70.0.10:5060

# ---- esl-controller ---------------------------------------------------------
# Health and the ESL listener share 8088/8022 in the inventory today, which
# collides when both containers run on one host under --network host. Locally,
# give each service its own health port.
ESL_LISTEN_ADDR=0.0.0.0:8022
ESL_TCP_KEEPALIVE_SECONDS=60

FREESWITCH_NODES=10.70.20.10
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=ClueCon

# NO KAMAILIO ADDRESS. The controller never talks to Kamailio; FreeSWITCH does,
# and the dialplan exports sip_route_uri onto the outbound leg from
# edge_private_ips in the Ansible inventory. One address, one place.

# A separate EBS volume on the FreeSWITCH nodes, not a directory on root:
# recordings are the thing most likely to fill a disk, and a full root volume
# takes FreeSWITCH down along with the SSM agent.
RECORDING_PATH=/mnt/recordings

# Where FreeSWITCH opens the per-call socket once an OUTBOUND call is answered
# — this service's own address, the same value the inbound dialplan uses as
# freeswitch_esl_outbound_target. Unset disables the originate worker; inbound
# calls are unaffected.
ESL_CALLBACK_TARGET=esl.beta.intron.internal:8022

# Empty until LiveKit's address is confirmed. Empty means the AI leg does not
# connect, which is the intended failure — a guessed address that resolves is
# worse.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
